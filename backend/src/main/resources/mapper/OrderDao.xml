<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.OrderDao">

    <resultMap id="BaseResultMap" type="com.example.demo.model.Order">
        <!--@Table user-->
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="customerId" column="customerId" jdbcType="INTEGER"/>
        <result property="workerId" column="workerId" jdbcType="INTEGER"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="situ" column="situ" jdbcType="VARCHAR"/>
        <result property="address" column="address" jdbcType="VARCHAR"/>
        <result property="price" column="price" jdbcType="INTEGER"/>
    </resultMap>

    <!--新增订单-->
    <insert id="newOrder">
        insert into ordert(customerId, type,situ, address, price)
        values(#{customerId},#{type},"正在发布",#{address},#{price})
    </insert>

    <!--查询与用户相关的订单-->
    <select id="queryByCustomerId" resultMap="BaseResultMap">
        SELECT * from ordert where ordert.customerid=#{customerid}
    </select>


    <select id="queryByWorkId" resultMap="BaseResultMap">
        SELECT * from ordert where workerid = #{workerid}
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        select
        *
        from ordert
    </select>

    <!--    更新用户信息-->
    <update id="updateOrder">
        update ordert
        <set>
            <if test="situ!=null">
                situ = #{situ},
            </if>
            <if test="workerId!=0">
                workerId=#{workerId}
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete">
        delete from ordert where Id = #{id}
    </delete>

</mapper>

